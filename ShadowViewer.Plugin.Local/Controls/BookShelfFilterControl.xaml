<UserControl
    x:Class="ShadowViewer.Plugin.Local.Controls.BookShelfFilterControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18N="using:ShadowViewer.Plugin.Local.I18n"
    xmlns:models="using:ShadowViewer.Plugin.Local.Models">
    <Grid MinWidth="400" MaxWidth="480" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="8">
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{i18N:Locale Key=BookShelfFilterDescription}"
                TextWrapping="Wrap" />
            <Button Command="{x:Bind ViewModel.ResetCommand}" Content="{i18N:Locale Key=ClearBookShelfFilter}" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" MaxHeight="420" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">
                <StackPanel Spacing="6">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{i18N:Locale Key=Tag}" />
                    <ListView
                        MaxHeight="120"
                        ItemsSource="{x:Bind ViewModel.Tags}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:BookShelfFilterOption">
                                <CheckBox Content="{x:Bind Name}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{i18N:Locale Key=NoFilterTags}"
                        Visibility="{x:Bind ViewModel.Tags.Count, Converter={StaticResource CollectionToVisibilityConverter}}" />
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{i18N:Locale Key=Author}" />
                    <ListView
                        MaxHeight="120"
                        ItemsSource="{x:Bind ViewModel.Authors}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:BookShelfFilterOption">
                                <CheckBox Content="{x:Bind Name}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{i18N:Locale Key=NoFilterAuthors}"
                        Visibility="{x:Bind ViewModel.Authors.Count, Converter={StaticResource CollectionToVisibilityConverter}}" />
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{i18N:Locale Key=CreateTime}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CalendarDatePicker
                            HorizontalAlignment="Stretch"
                            Date="{x:Bind ViewModel.CreatedFrom, Mode=TwoWay}"
                            Header="{i18N:Locale Key=FilterStartDate}"
                            PlaceholderText="{i18N:Locale Key=FilterNoLimit}" />
                        <CalendarDatePicker
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Date="{x:Bind ViewModel.CreatedTo, Mode=TwoWay}"
                            Header="{i18N:Locale Key=FilterEndDate}"
                            PlaceholderText="{i18N:Locale Key=FilterNoLimit}" />
                    </Grid>
                </StackPanel>
                <ComboBox
                    HorizontalAlignment="Stretch"
                    Header="{i18N:Locale Key=FilterReadingStatus}"
                    SelectedIndex="{x:Bind ViewModel.ReadingStatusIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{i18N:Locale Key=FilterAll}" />
                    <ComboBoxItem Content="{i18N:Locale Key=FilterUnread}" />
                    <ComboBoxItem Content="{i18N:Locale Key=FilterReading}" />
                    <ComboBoxItem Content="{i18N:Locale Key=FilterCompleted}" />
                </ComboBox>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <NumberBox
                        Header="{i18N:Locale Key=FilterProgressFrom}"
                        Maximum="100"
                        Minimum="0"
                        PlaceholderText="{i18N:Locale Key=FilterNoLimit}"
                        Value="{x:Bind ViewModel.ProgressFrom, Mode=TwoWay}" />
                    <NumberBox
                        Grid.Column="1"
                        Header="{i18N:Locale Key=FilterProgressTo}"
                        Maximum="100"
                        Minimum="0"
                        PlaceholderText="{i18N:Locale Key=FilterNoLimit}"
                        Value="{x:Bind ViewModel.ProgressTo, Mode=TwoWay}" />
                </Grid>
                <StackPanel Spacing="6">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{i18N:Locale Key=FilterLastReadTime}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CalendarDatePicker
                            HorizontalAlignment="Stretch"
                            Date="{x:Bind ViewModel.LastReadFrom, Mode=TwoWay}"
                            Header="{i18N:Locale Key=FilterStartDate}"
                            PlaceholderText="{i18N:Locale Key=FilterNoLimit}" />
                        <CalendarDatePicker
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Date="{x:Bind ViewModel.LastReadTo, Mode=TwoWay}"
                            Header="{i18N:Locale Key=FilterEndDate}"
                            PlaceholderText="{i18N:Locale Key=FilterNoLimit}" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <TextBlock
            Grid.Row="2"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            TextWrapping="Wrap" />
    </Grid>
</UserControl>
